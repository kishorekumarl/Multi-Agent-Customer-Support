# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is git-ignored and docker-ignored: never commit or bake in a real key.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=your_api_key_here

# --- Optional (the values below are the defaults) -------------------------
# Chat model used for verification, memory extraction, the supervisor and the agents.
# MODEL_NAME=gpt-4o

# Sampling temperature. 0.0 keeps answers and extraction as deterministic as possible.
# TEMPERATURE=0.0

# Base URL for an OpenAI-compatible API (a proxy, Azure, a local server, ...).
# OPENAI_API_BASE=https://api.openai.com/v1

# Port the web app listens on. If you change it in Docker, also change the -p mapping.
# PORT=7860

# Database. The default builds an in-memory Chinook database at startup.
# DATABASE_URL=sqlite:///:memory:

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Write each tool's request and full JSON response to the log (truncated at 2000 chars).
# Responses can contain customer data such as addresses and emails: set false outside local dev.
# LOG_TOOL_PAYLOADS=true
